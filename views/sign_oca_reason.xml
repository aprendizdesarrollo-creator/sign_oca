<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="sign_oca_reason_list_view">
        <field name="name">sign.oca.reason.list</field>
        <field name="model">sign.oca.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="usage" />
                <field name="requires_detail" />
                <field name="is_default" />
                <field name="description" optional="hide" />
                <field name="active" column_invisible="1" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="sign_oca_reason_form_view">
        <field name="name">sign.oca.reason.form</field>
        <field name="model">sign.oca.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archivado"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="Ej.: Documento vencido" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="usage" />
                            <field name="sequence" />
                            <field name="active" invisible="1" />
                        </group>
                        <group>
                            <field name="requires_detail" />
                            <field name="is_default" />
                        </group>
                    </group>
                    <group string="Cuándo usarlo">
                        <field name="description" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="sign_oca_reason_act_window">
        <field name="name">Motivos de cancelación y rechazo</field>
        <field name="res_model">sign.oca.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer motivo</p>
            <p>
                Los motivos aparecen al cancelar una solicitud y al rechazar una
                firma desde el portal. Marca «Exigir detalle» para obligar a
                explicar el caso.
            </p>
        </field>
    </record>

    <record model="ir.ui.menu" id="sign_oca_reason_menu">
        <field name="name">Motivos de cancelación y rechazo</field>
        <field name="parent_id" ref="sign_oca.sign_oca_settings_menu" />
        <field name="action" ref="sign_oca_reason_act_window" />
        <field name="sequence" eval="30" />
    </record>
</odoo>
