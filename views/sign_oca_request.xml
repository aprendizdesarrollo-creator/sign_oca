<odoo>
    <record model="ir.ui.view" id="sign_oca_request_form_view">
        <field name="name">sign.oca.request.form (in sign_oca)</field>
        <field name="model">sign.oca.request</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button
                        string="Sign"
                        name="sign"
                        class="btn btn-primary"
                        type="object"
                        invisible="not to_sign or state != '0_sent'"
                    />
                    <field name="to_sign" invisible="1" />
                    <button
                        string="Send"
                        type="object"
                        invisible="state != '1_draft'"
                        name="action_send"
                        icon="fa-paper-plane"
                    />
                    <button
                        string="Cancel"
                        type="object"
                        invisible="state not in ['1_draft', '0_sent', '2_signed']"
                        name="action_cancel_wizard"
                        groups="sign_oca.sign_oca_group_user"
                    />
                    <button
                        string="Imprimir certificado"
                        type="action"
                        name="%(sign_oca.action_report_signature_certificate)d"
                        icon="fa-print"
                        invisible="state != '2_signed'"
                    />
                    <button
                        string="Descargar firmado"
                        type="object"
                        name="action_download_signed"
                        icon="fa-download"
                        invisible="state != '2_signed'"
                    />
                    <button
                        string="Enviar certificado"
                        type="object"
                        name="action_send_certificate"
                        icon="fa-envelope"
                        invisible="state != '2_signed'"
                        groups="sign_oca.sign_oca_group_user"
                        confirm="Se enviará por correo el certificado y el documento firmado (protegido) a todos los firmantes y al responsable. ¿Continuar?"
                    />
                    <button
                        string="Vista portal"
                        type="object"
                        name="action_open_portal"
                        icon="fa-external-link"
                        invisible="state not in ['0_sent', '2_signed'] or not to_sign"
                        groups="sign_oca.sign_oca_group_user"
                    />
                    <button
                        string="Nueva versión"
                        type="object"
                        name="action_new_version"
                        icon="fa-code-fork"
                        class="btn-primary"
                        invisible="state not in ['3_cancel', '4_rejected'] or has_newer_version"
                        groups="sign_oca.sign_oca_group_user"
                    />
                    <field name="has_newer_version" invisible="1" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="0_sent,2_signed"
                        readonly="1"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="preview"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil"
                            invisible="state not in ['0_sent', '2_signed']"
                            groups="sign_oca.sign_oca_group_user"
                        >
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field
                                    name="signed_count"
                                />/<field name="signer_count" /><span
                                    class="o_stat_text"
                                > Signed</span></span>
                            </div>
                        </button>
                        <button
                            class="oe_stat_button"
                            icon="fa-wrench"
                            invisible="state not in ['1_draft']"
                            name="configure"
                            type="object"
                            string="Configure"
                            groups="sign_oca.sign_oca_group_user"
                        />
                        <button
                            class="oe_stat_button"
                            icon="fa-pencil"
                            name="%(sign_oca_request_log_act_window)s"
                            type="action"
                            string="Activity Log"
                            groups="sign_oca.sign_oca_group_user"
                        />
                        <button
                            class="oe_stat_button"
                            icon="fa-code-fork"
                            name="action_view_versions"
                            type="object"
                            invisible="version == 1 and not has_newer_version"
                        >
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">v<field
                                    name="version"
                                /></span>
                                <span class="o_stat_text">Versiones</span>
                            </div>
                        </button>
                    </div>
                    <field name="active" invisible="1" />
                    <widget
                        name="web_ribbon"
                        title="Fully Signed"
                        invisible="state != '2_signed'"
                    />
                    <widget
                        name="web_ribbon"
                        bg_color="bg-danger"
                        title="Cancelled"
                        invisible="state != '3_cancel'"
                    />
                    <widget
                        name="web_ribbon"
                        bg_color="bg-danger"
                        title="Rechazado"
                        invisible="state != '4_rejected'"
                    />
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="state != '3_cancel' or (not cancellation_reason and not cancel_reason_id)"
                    >
                        <field name="cancelled_by_id" readonly="1" nolabel="1" />
                        canceló esta solicitud de firma
                        <field
                            name="cancelled_on"
                            readonly="1"
                            nolabel="1"
                            class="oe_inline"
                        />.
                        <div class="mt-1">
                            <b>Motivo:</b>
                            <field
                                name="cancel_reason_id"
                                readonly="1"
                                nolabel="1"
                                class="oe_inline"
                            />
                            <field
                                name="cancellation_reason"
                                readonly="1"
                                nolabel="1"
                                invisible="not cancellation_reason"
                            />
                        </div>
                    </div>
                    <div
                        class="alert alert-danger"
                        role="alert"
                        invisible="state != '4_rejected'"
                    >
                        <field name="rejected_signer_id" readonly="1" nolabel="1" />
                        rechazó la firma de este documento.
                        <div class="mt-1">
                            <b>Motivo:</b>
                            <field
                                name="reject_reason_id"
                                readonly="1"
                                nolabel="1"
                                class="oe_inline"
                            />
                            <field
                                name="rejection_reason"
                                readonly="1"
                                nolabel="1"
                                invisible="not rejection_reason"
                            />
                        </div>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div
                        class="alert alert-info"
                        role="alert"
                        invisible="not parent_request_id"
                    >
                        Versión <field
                            name="version"
                            readonly="1"
                            nolabel="1"
                            class="oe_inline"
                        /> de este documento, creada a partir de
                        <field
                            name="parent_request_id"
                            readonly="1"
                            nolabel="1"
                            class="oe_inline"
                        />.
                        <span invisible="not version_signatures_kept">
                            Se dieron por válidas las firmas anteriores.
                        </span>
                        <span invisible="version_signatures_kept">
                            Se pidieron todas las firmas de nuevo.
                        </span>
                        <field
                            name="version_note"
                            readonly="1"
                            nolabel="1"
                            invisible="not version_note"
                        />
                    </div>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <field
                            name="data"
                            filename="filename"
                            readonly="state != '1_draft'"
                        />
                        <field name="filename" invisible="1" />
                        <field
                            name="template_id"
                            invisible="not template_id"
                            readonly="1"
                        />
                        <field name="user_id" readonly="state != '1_draft'" />
                        <field name="record_ref" readonly="state != '1_draft'" />
                    </group>

                    <field name="signer_ids" nolabel="1" readonly="state != '1_draft'">
                        <list editable="bottom">
                            <field name="role_id" />
                            <field name="partner_id" />
                            <field name="signed_on" readonly="1" />
                            <field name="rejected_on" readonly="1" optional="show" />
                        </list>
                    </field>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="sign_oca_request_search_view">
        <field name="name">sign.oca.request.search (in sign_oca)</field>
        <field name="model">sign.oca.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="template_id" />
                <field
                    name="signer_ids"
                    filter_domain="[('signer_ids.partner_id', 'child_of', raw_value)]"
                />
                <separator />
                <filter
                    name="created_by_me"
                    string="My Documents"
                    domain="[('user_id', '=', uid)]"
                />
                <filter
                    name="sign_by_me"
                    string="My Requests"
                    domain="[('signer_ids.partner_id.user_ids', 'in', uid)]"
                />
                <separator />
                <filter
                    name="to_sign_by_me"
                    string="Mis firmas pendientes"
                    domain="[('signer_ids', 'any', [('partner_id.user_ids', 'in', uid), ('signed_on', '=', False), ('rejected_on', '=', False)]), ('state', '=', '0_sent')]"
                />
                <filter
                    name="signed_by_me"
                    string="Mis documentos firmados"
                    domain="[('signer_ids', 'any', [('partner_id.user_ids', 'in', uid), ('signed_on', '!=', False)])]"
                />
                <filter
                    name="other_documents"
                    string="Otros documentos"
                    domain="[('signer_ids', 'not any', [('partner_id.user_ids', 'in', uid)])]"
                />
                <separator />
                <filter name="sent" string="Sent" domain="[('state', '=', '0_sent')]" />
                <filter
                    name="signed"
                    string="Signed"
                    domain="[('state', '=', '2_signed')]"
                />
                <filter
                    name="canceled"
                    string="Canceled"
                    domain="[('state', '=', '3_cancel')]"
                />
                <filter
                    name="rejected"
                    string="Rechazados"
                    domain="[('state', '=', '4_rejected')]"
                />
                <separator />
                <filter
                    string="Late Activities"
                    name="activities_overdue"
                    domain="[('my_activity_date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                    help="Show all records which has next action date is before today"
                />
                <filter
                    string="Today Activities"
                    name="activities_today"
                    domain="[('my_activity_date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"
                />
                <filter
                    string="Future Activities"
                    name="activities_upcoming_all"
                    domain="[('my_activity_date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))                         ]"
                />
                <separator />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_template_id"
                        string="Template"
                        domain="[]"
                        context="{'group_by': 'template_id'}"
                    />
                    <filter
                        name="group_by_state"
                        string="State"
                        domain="[]"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="sign_oca_request_tree_view">
        <field name="name">sign.oca.request.list (in sign_oca)</field>
        <field name="model">sign.oca.request</field>
        <field name="arch" type="xml">
            <list decoration-success="state == '2_signed'" decoration-muted="state == '3_cancel'">
                <field name="name" />
                <field name="state" />
                <field
                    name="signed_partner_ids"
                    widget="many2many_tags"
                    string="Firmaron"
                />
                <field
                    name="pending_partner_ids"
                    widget="many2many_tags"
                    string="Pendientes"
                />
                <field name="user_id" />
                <field name="create_date" />
                <field name="write_date" />
                <field name="record_ref" />
                <button
                    string="Sign"
                    name="sign"
                    class="btn btn-primary"
                    type="object"
                    invisible="not to_sign or state != '0_sent'"
                />
                <field name="to_sign" column_invisible="1" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="sign_oca_request_kanban_view">
        <field name="name">sign.oca.request.kanban (in sign_oca)</field>
        <field name="model">sign.oca.request</field>
        <field name="arch" type="xml">
            <kanban quick_create="false" default_order="create_date desc">
                <field name="active" />
                <field name="name" />
                <field name="create_uid" />
                <field name="signer_ids" />
                <field name="state" />
                <field name="activity_ids" />
                <field name="activity_state" />
                <field name="template_id" />
                <templates>
                    <t t-name="menu">
                        <a
                            role="menuitem"
                            type="object"
                            name="get_formview_action"
                            class="dropdown-item"
                        >Details</a>
                        <a
                            role="menuitem"
                            type="object"
                            name="open_template"
                            t-if="record.template_id.raw_value"
                            class="dropdown-item"
                        >Template</a>
                        <a
                            role="menuitem"
                            type="object"
                            name="toggle_active"
                            class="dropdown-item"
                        >
                            <t t-if="record.active.raw_value">Archive</t>
                            <t t-else="">Restore</t>
                        </a>
                    </t>
                    <t t-name="card">
                        <div class="row">
                            <field class="fw-bolder" name="name" />
                            <field
                                name="signer_ids"
                                widget="many2many_tags"
                                class="mt-2"
                            />

                            <footer>
                                <div class="row mt-2">
                                    <div class="col-6">
                                        <em>
                                            <field name="create_date" widget="date" />
                                        </em>
                                    </div>
                                    <div class="col-3">
                                        <field
                                            name="activity_ids"
                                            widget="kanban_activity"
                                        />
                                    </div>
                                    <div class="col-3">
                                        <field
                                            name="user_id"
                                            widget="many2one_avatar_user"
                                        />
                                    </div>
                                </div>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.ui.view" id="sign_oca_request_signer_tree_view">
        <field name="name">sign.oca.request.signer.list (in sign_oca)</field>
        <field name="model">sign.oca.request.signer</field>
        <field name="arch" type="xml">
            <list edit="0" delete="0" create="0" decoration-danger="altered_hash">
                <field name="role_id" />
                <field name="partner_id" />
                <field name="request_id" />
                <field name="signed_on" />
                <field name="altered_hash" invisible="1" />
            </list>
        </field>
    </record>
    <record model="ir.ui.view" id="sign_oca_request_signer_form_view">
        <field name="name">sign.oca.request.signer.form (in sign_oca)</field>
        <field name="model">sign.oca.request.signer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        string="Sign"
                        class="btn btn-primary"
                        type="object"
                        name="sign"
                        invisible="not is_allow_signature"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="is_allow_signature" invisible="1" />
                        <field name="role_id" readonly="1" />
                        <field name="partner_id" readonly="1" />
                        <field name="request_id" readonly="1" />
                        <field name="signed_on" />
                        <field name="rejected_on" readonly="1" />
                        <field
                            name="rejection_reason"
                            readonly="1"
                            invisible="not rejected_on"
                        />
                        <field name="inalterable_hash" />
                        <field name="latitude" />
                        <field name="longitude" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="sign_oca_request_signer_kanban_view">
        <field name="name">sign.oca.request.signer.kanban (in sign_oca)</field>
        <field name="model">sign.oca.request.signer</field>
        <field name="arch" type="xml">
            <kanban create="false" default_order="create_date desc">
                <field name="role_id" />
                <field name="partner_id" />
                <field name="request_id" />
                <field name="signed_on" />
                <field name="altered_hash" invisible="1" />
                <templates>
                    <t t-name="menu">
                        <a
                            role="menuitem"
                            type="object"
                            name="get_formview_action"
                            class="dropdown-item"
                        >Details</a>
                    </t>
                    <t t-name="card">
                        <div class="row">
                            <field class="fw-bolder" name="request_id" />
                            <field name="role_id" class="mt-2" />
                            <footer>
                                <div class="row mt-2">
                                    <div class="col-6">
                                        <em>
                                            <field name="create_date" widget="date" />
                                        </em>
                                    </div>
                                    <div class="col-3">
                                        <field
                                            name="activity_ids"
                                            widget="kanban_activity"
                                        />
                                    </div>
                                    <div class="col-3">
                                        <field
                                            name="partner_id"
                                            widget="many2one_avatar_user"
                                        />
                                    </div>
                                </div>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.ui.view" id="sign_oca_request_signer_search_view">
        <field name="name">sign.oca.request.signer.search (in sign_oca)</field>
        <field name="model">sign.oca.request.signer</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_id" />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_create_date"
                        string="Create date"
                        domain="[]"
                        context="{'group_by': 'create_date'}"
                    />
                    <filter
                        name="group_by_role_id"
                        string="Role"
                        domain="[]"
                        context="{'group_by': 'role_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="sign_oca_request_signer_act_window">
        <field name="name">Sign Request Signers</field>
        <field name="res_model">sign.oca.request.signer</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.actions.act_window" id="sign_oca_request_act_window">
        <field name="name">Sign Requests</field>
        <field name="res_model">sign.oca.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[]</field>
        <!-- Al entrar se muestran primero los documentos que esperan la firma
             del usuario; el filtro se quita con un clic para ver todos. -->
        <field name="context">{'search_default_to_sign_by_me': 1}</field>
    </record>

    <record model="ir.actions.act_window" id="sign_oca_request_template_act_window">
        <field name="name">Sign Requests</field>
        <field name="res_model">sign.oca.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('template_id', '=', active_id)]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="sign_oca_request_menu">
        <field name="name">Requests</field>
        <field name="parent_id" ref="sign_oca_root_menu" />
        <field name="action" ref="sign_oca_request_act_window" />
        <!-- Solicitudes primero en la barra superior -->
        <field name="sequence" eval="10" />
    </record>
</odoo>
