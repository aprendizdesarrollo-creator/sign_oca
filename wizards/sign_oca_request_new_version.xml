<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="sign_oca_request_new_version_form_view">
        <field name="name">sign.oca.request.new.version.form</field>
        <field name="model">sign.oca.request.new.version</field>
        <field name="arch" type="xml">
            <form>
                <field name="request_id" invisible="1" />
                <field name="signed_count" invisible="1" />
                <group>
                    <field
                        name="data"
                        filename="filename"
                        widget="binary"
                        string="Documento corregido"
                    />
                    <field name="filename" invisible="1" />
                    <field
                        name="version_note"
                        placeholder="Ej.: se corrigió el valor del anexo 2 y la vigencia."
                    />
                </group>
                <group
                    string="Firmas ya realizadas"
                    invisible="signed_count == 0"
                >
                    <field name="signature_policy" widget="radio" nolabel="1" />
                    <div class="text-muted" colspan="2">
                        Este documento ya tiene <field
                            name="signed_count"
                            readonly="1"
                            nolabel="1"
                            class="oe_inline"
                        /> firma(s).
                        Si el texto cambió en algo que les afecte, lo correcto es pedirlas de nuevo.
                    </div>
                </group>
                <footer>
                    <button
                        string="Crear versión"
                        name="action_create_version"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
