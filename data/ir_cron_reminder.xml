<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_sign_oca_reminder" model="ir.cron">
        <field name="name">Sign: recordatorio de firmas pendientes</field>
        <field name="model_id" ref="model_sign_oca_request" />
        <field name="state">code</field>
        <field name="code">model._cron_remind_pending_signers(days=3)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>
</odoo>
