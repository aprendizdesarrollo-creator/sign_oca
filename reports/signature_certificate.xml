<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_signature_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sign_oca.report_signature_certificate_doc" />
            </t>
        </t>
    </template>

    <template id="report_signature_certificate_doc">
        <t t-call="web.external_layout">
            <div class="page">
                <h1 class="mb32">
                    <i class="fa fa-certificate text-warning me-2" title="Certificado" />Certificado de Firmas
                </h1>

                <!-- Información del documento -->
                <div class="document_information mb32">
                    <div class="row mb16">
                        <div class="col-12">
                            <h3 class="text-muted">
                                <i class="fa fa-file-text-o me-2" title="Documento" />Información del documento
                            </h3>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="mb8" id="signature_filename">
                                <span class="fw-bold">Archivo:</span>
                                <span class="text-break" t-field="o.filename" />
                            </div>
                            <div class="mb8" id="created_on">
                                <span class="fw-bold">Creado el:</span>
                                <span
                                    t-field="o.create_date"
                                    t-options='{"widget": "datetime", "format": "dd-MM-YYYY HH:mm:ss", "tz_name": "UTC"}'
                                />
                                <span>(UTC)</span>
                            </div>
                            <div class="mb8" id="created_by">
                                <span class="fw-bold">Creado por:</span>
                                <span t-field="o.create_uid" />
                            </div>
                            <div class="mb8" id="print_date">
                                <span class="fw-bold">Fecha de impresión:</span>
                                <span
                                    t-esc="datetime.datetime.utcnow().strftime('%d-%m-%Y %H:%M:%S')"
                                />
                                <span>(UTC)</span>
                            </div>
                            <div class="mb8" id="responsible">
                                <span class="fw-bold">Responsable:</span>
                                <span t-field="o.user_id" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="mb8" id="document_id">
                                <span class="fw-bold">ID del documento:</span>
                                <span t-field="o.id" />
                            </div>
                            <div class="mb8" id="related_record" t-if="o.record_ref">
                                <t
                                    t-set="model_name"
                                    t-value="o.record_ref and o.record_ref.sudo()._name"
                                />
                                <t
                                    t-set="model_display_name"
                                    t-value="model_name and env['ir.model'].sudo().search([('model', '=', model_name)], limit=1).name"
                                />
                                <span class="fw-bold">Registro relacionado:</span>
                                <span t-esc="model_display_name" />
                                <span>-</span>
                                <span t-field="o.record_ref.sudo().display_name" />
                            </div>
                            <div class="mb8" id="signers">
                                <t
                                    t-set="signer_remaining"
                                    t-value="o.signer_count - o.signed_count"
                                />
                                <span class="fw-bold">Firmantes:</span>
                                <span t-field="o.signer_count" />
                                <span>en total →</span>
                                <span t-field="o.signed_count" />
                                <span>firmaron,</span>
                                <span t-esc="signer_remaining" />
                                <span>pendientes</span>
                            </div>
                            <div class="mb8" id="current_hash">
                                <span class="fw-bold">Hash actual del documento:</span>
                                <br />
                                <code
                                    class="text-break"
                                    style="font-size: 8pt;"
                                ><span t-field="o.current_hash" /></code>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Firmantes -->
                <div class="document_signers mb32" t-if="o.signer_ids">
                    <div class="row mb16">
                        <div class="col-12" id="document_signers_title">
                            <h3 class="text-muted">
                                <i class="fa fa-users me-2" title="Firmantes" />Firmantes
                            </h3>
                        </div>
                    </div>
                    <div class="row pt4">
                        <div class="col-12" id="document_signers_table">
                            <table class="table table-bordered">
                                <thead
                                    class="bg-100"
                                    style="border-bottom: 2px solid #dee2e6;"
                                >
                                    <tr>
                                        <th class="text-start">Firmante</th>
                                        <th class="text-start">Correo</th>
                                        <th class="text-start">Rol</th>
                                        <th class="text-start">¿Firmó?</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.signer_ids" t-as="signer">
                                        <tr>
                                            <td t-esc="signer.partner_name" />
                                            <td
                                                t-esc="signer.partner_id.sudo().email"
                                            />
                                            <td
                                                t-esc="signer.role_id.sudo().display_name"
                                            />
                                            <td>
                                                <span
                                                    t-if="signer.inalterable_hash"
                                                    class="text-success"
                                                ><i
                                                        class="fa fa-check-circle me-1"
                                                        title="Firmado"
                                                    />Firmó</span>
                                                <span
                                                    t-else=""
                                                    class="text-danger"
                                                ><i
                                                        class="fa fa-clock-o me-1"
                                                        title="Pendiente"
                                                    />Pendiente</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Firmas -->
                <t
                    t-set="signature_ids"
                    t-value="o.signer_ids.filtered(lambda s: s.inalterable_hash)"
                />
                <div class="document_signatures mb32" t-if="signature_ids">
                    <div class="row mb16">
                        <div class="col-12" id="document_signatures_title">
                            <h3 class="text-muted">
                                <i class="fa fa-pencil me-2" title="Firmas" />Firmas
                            </h3>
                        </div>
                    </div>
                    <div class="row pt4">
                        <div class="col-12" id="document_signatures_table">
                            <table class="table table-bordered">
                                <thead
                                    class="bg-100"
                                    style="border-bottom: 2px solid #dee2e6;"
                                >
                                    <tr>
                                        <th class="text-start">Firmante</th>
                                        <th class="text-start">Firmado el</th>
                                        <th class="text-start">Geolocalización</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="signature_ids" t-as="signature">
                                        <tr>
                                            <td t-esc="signature.partner_name" />
                                            <td>
                                                <span
                                                    t-esc="signature.signed_on"
                                                    t-options='{"widget": "datetime", "format": "dd-MM-YYYY HH:mm:ss", "tz_name": "UTC"}'
                                                />
                                                <span>(UTC)</span>
                                            </td>
                                            <td>
                                                <t
                                                    t-if="signature.latitude or signature.longitude"
                                                >
                                                    <i
                                                        class="fa fa-map-marker me-1"
                                                        title="Ubicación"
                                                    />
                                                    <span t-esc="signature.latitude" />
                                                    <span>-</span>
                                                    <span t-esc="signature.longitude" />
                                                </t>
                                                <span
                                                    t-else=""
                                                    class="text-muted"
                                                >No disponible</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="3">
                                                <i
                                                    class="fa fa-key me-1 text-muted"
                                                    title="Hash"
                                                />
                                                <span
                                                    class="text-muted"
                                                >Hash de inalterabilidad (token de la firma):</span>
                                                <br />
                                                <code
                                                    class="text-break"
                                                    style="font-size: 8pt;"
                                                ><span
                                                        t-esc="signature.inalterable_hash"
                                                    /></code>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Bitácora de actividad -->
                <t
                    t-set="request_logs"
                    t-value="env['sign.oca.request.log'].sudo().search([('request_id', '=', o.id), ('action', 'in', ['create', 'validate', 'view', 'sign', 'cancel'])])"
                />
                <div class="document_activity_logs mb32" t-if="request_logs">
                    <div class="row mb16">
                        <div class="col-12" id="document_activity_logs_title">
                            <h3 class="text-muted">
                                <i class="fa fa-history me-2" title="Bitácora" />Bitácora de actividad
                            </h3>
                        </div>
                    </div>
                    <div class="row pt4">
                        <div class="col-12" id="document_activity_logs_table">
                            <table class="table table-bordered">
                                <thead
                                    class="bg-100"
                                    style="border-bottom: 2px solid #dee2e6;"
                                >
                                    <tr>
                                        <th class="text-start">Acción</th>
                                        <th class="text-start">Fecha (UTC)</th>
                                        <th class="text-start">Persona</th>
                                        <th class="text-start">Dirección IP</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="action_labels" t-value="{'create': 'Creación', 'validate': 'Validación', 'view': 'Visualización', 'sign': 'Firma', 'cancel': 'Cancelación'}" />
                                    <t t-foreach="request_logs" t-as="log">
                                        <tr>
                                            <td
                                                t-esc="action_labels.get(log.action, log.action)"
                                            />
                                            <td
                                                t-esc="log.date"
                                                t-options='{"widget": "datetime", "format": "dd-MM-YYYY HH:mm:ss", "tz_name": "UTC"}'
                                            />
                                            <td>
                                                <t t-if="not log.signer_id">
                                                    <span
                                                        t-esc="log.partner_id.sudo().name"
                                                    />
                                                </t>
                                                <t t-else="">
                                                    <span
                                                        t-esc="log.signer_id.sudo().partner_name"
                                                    />
                                                </t>
                                            </td>
                                            <td>
                                                <t t-if="log.ip">
                                                    <span t-esc="log.ip" />
                                                </t>
                                                <t t-else="">
                                                    <span
                                                        class="text-muted"
                                                    >No disponible</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
